[
  {
    "kernelSource": {
      "name": "ruby",
      "repo": "https://github.com/wodanesdag/android_kernel_xiaomi_mt6877",
      "branch": "susfs",
      "device": "ruby",
      "defconfig": "ruby_defconfig"
    },
    "withKernelSU": true,
    "withSuSFS": true,
    "toolchains": [
      {
        "repo": "https://gitlab.com/wodanesdag/android_prebuilts_clang_host_linux-x86_clang-r563880",
        "branch": "master",
        "name": "clang",
        "binPath": ["./bin"]
      }
    ],
    "ccache": true,
    "params": {
      "ARCH": "arm64",
      "CC": "clang/bin/clang",
      "externalCommand": {
        "KBUILD_BUILD_HOST": "LEGION",
        "KBUILD_BUILD_USER": "wodanesdag",
        "CROSS_COMPILE": "clang/bin/aarch64-linux-gnu-",
        "CROSS_COMPILE_ARM32": "clang/bin/arm-linux-gnueabi-",
        "LD": "clang/bin/ld.lld",
        "LLVM": "1",
        "LLVM_IAS": "1",
        "AR": "clang/bin/llvm-ar",
        "NM": "clang/bin/llvm-nm",
        "OBJCOPY": "clang/bin/llvm-objcopy",
        "OBJDUMP": "clang/bin/llvm-objdump",
        "READELF": "clang/bin/llvm-readelf",
        "OBJSIZE": "clang/bin/llvm-size",
        "STRIP": "clang/bin/llvm-strip",
        "LDGOLD": "clang/bin/aarch64-linux-gnu-ld.gold",
        "LLVM_AR": "clang/bin/llvm-ar",
        "LLVM_DIS": "clang/bin/llvm-dis"
      }
    },
    "AnyKernel3": {
      "use": true,
      "release": true,
      "repo": "https://github.com/wodanesdag/AnyKernel3/",
      "branch": "ruby"
    }
  }
]
